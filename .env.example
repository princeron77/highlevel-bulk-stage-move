# Only needed when running outside Docker (npm run start:api / start:worker).
# Values match docker-compose.yml.
DATABASE_URL=postgres://app:app@localhost:5432/opportunities
PORT=3000
LOG_LEVEL=info

# Worker tuning (defaults shown)
BULK_CHUNK_SIZE=500
BULK_SLICE_MS=2000
BULK_LEASE_MS=15000
BULK_HEARTBEAT_MS=5000
BULK_IDLE_MS=250
BULK_MAX_ATTEMPTS=5
BULK_BACKOFF_BASE_MS=500
BULK_BACKOFF_MAX_MS=30000
# progress reports 'stalled' after this long with no committed chunk
BULK_STALL_AFTER_MS=300000

# Test hook only: worker exits right after this many chunks commit (0 = off)
CRASH_AFTER_CHUNKS=0
