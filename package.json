{
  "name": "highlevel-bulk-stage-move",
  "version": "1.0.0",
  "private": true,
  "description": "Idempotent, resumable, fair bulk stage move for a CRM Opportunities service (NestJS + PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/src/main.api.js",
    "start:worker": "node dist/src/main.worker.js",
    "db:migrate": "node dist/scripts/migrate.js",
    "db:seed:small": "node dist/scripts/seed.js small",
    "db:seed:large": "node dist/scripts/seed.js large",
    "test": "node --test --test-concurrency=1 --test-reporter=spec \"dist/test/**/*.test.js\"",
    "lint": "tsc -p tsconfig.json --noEmit",
    "bench": "node dist/bench/run.js",
    "bench:kill": "node dist/bench/run.js --kill"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/swagger": "^12.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "typescript": "^5.9.3"
  }
}
